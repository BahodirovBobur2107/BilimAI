5:[['Kompyuter qurilmalari','Kompyuter kiritish qurilmalari (klaviatura, sichqoncha, mikrofon, skaner), chiqarish qurilmalari (monitor, printer, karnay) va tizim blokidan iborat. Protsessor — kompyuterning “miyasi”, u barcha hisob-kitoblarni bajaradi.',[['Qaysi biri chiqarish qurilmasi?',['Klaviatura','Sichqoncha','Printer','Skaner'],2],['Kompyuterning “miyasi” deb nimaga aytiladi?',['Monitor','Protsessor','Karnay','Klaviatura'],1]]],
['Fayl va papka','Fayl — kompyuterda nomlangan ma’lumot (matn, rasm, musiqa). Fayl nomi va kengaytmadan iborat: dars.docx, rasm.png. Papka (jild) fayllarni tartib bilan saqlash uchun xizmat qiladi.',[['“referat.docx” faylida kengaytma qaysi?',['referat','docx','referat.docx','.'],1],['Fayllarni tartibli saqlash uchun nima ishlatiladi?',['Papka','Printer','Karnay','Ekran'],0]]],
['Klaviatura bilan ishlash','Shift — bosh harf yozish, Enter — yangi qatorga o‘tish, Backspace — chapdagi belgini o‘chirish, Space (probel) — so‘zlar orasini ochish. Ctrl + C — nusxalash, Ctrl + V — qo‘yish.',[['Nusxalash uchun qaysi tugmalar birikmasi?',['Ctrl + V','Ctrl + C','Ctrl + Z','Alt + F4'],1],['Yangi qatorga o‘tish tugmasi?',['Enter','Shift','Esc','Tab'],0]]]],
6:[['Matn muharriri','Matn muharrirlari (masalan, MS Word, Google Docs) matn yozish, tahrirlash va bezash uchun ishlatiladi. Shrift turi, o‘lchami, rangi, qalin (B), kursiv (I) va tagiga chizilgan (U) formatlari bor.',[['Matnni qalin qilish belgisi?',['I','U','B','S'],2],['Qaysi biri matn muharriri?',['MS Word','Paint','Kalkulyator','Media Player'],0]]],
['Internetda xavfsizlik','Kuchli parol kamida 8 ta belgidan iborat bo‘lib, katta-kichik harflar, raqam va belgilarni o‘z ichiga oladi. Parolni hech kimga aytmang, notanish havolalarni ochmang va shaxsiy ma’lumotlaringizni begonalarga bermang.',[['Qaysi parol eng kuchli?',['123456','qwerty','Bilim#2026x','ismim'],2],['Notanish odam xabarda havola yubordi. Nima qilish kerak?',['Darhol ochish','Ochmasdan, kattalarga aytish','Parolni yuborish','Do‘stlarga tarqatish'],1]]],
['Elektron pochta','Elektron pochta (e-mail) — internet orqali xat yuborish xizmati. Manzil ko‘rinishi: ism@domen.uz — “@” belgisi albatta bo‘ladi. Xatga fayllarni ilova qilish mumkin.',[['E-mail manzilida albatta qaysi belgi bo‘ladi?',['#','@','&','%'],1],['To‘g‘ri e-mail manzil:',['ali.gmail.com','ali@gmail.com','ali@','@gmail'],1]]]],
7:[['Axborot o‘lchov birliklari','Eng kichik birlik — bit (0 yoki 1). 1 bayt = 8 bit, 1 KB = 1024 bayt, 1 MB = 1024 KB, 1 GB = 1024 MB.',[['1 bayt necha bit?',['4','8','10','1024'],1],['1 KB necha bayt?',['1000','1024','100','8'],1]]],
['Ikkilik sanoq sistemasi','Kompyuter ma’lumotni faqat 0 va 1 raqamlari yordamida saqlaydi. Ikkilikdagi 101 soni = 1·4 + 0·2 + 1·1 = 5. O‘nlikdagi 6 ikkilikda 110 ko‘rinishida yoziladi.',[['Ikkilikdagi 11 o‘nlikda nechaga teng?',['11','3','2','1'],1],['O‘nlikdagi 4 ikkilikda…',['100','11','4','010'],0]]],
['Elektron jadvallar','Elektron jadvallar (MS Excel, Google Sheets) hisob-kitob uchun ishlatiladi. Jadval katakchalardan iborat: A1, B2. Formula “=” belgisi bilan boshlanadi: =A1+B1, =SUM(A1:A5).',[['Excelda formula qaysi belgi bilan boshlanadi?',['+','=','#','@'],1],['A1 dan A5 gacha yig‘indini hisoblovchi formula?',['=SUM(A1:A5)','SUM A1-A5','=A1:A5','=ADD(A1,A5)'],0]]]],
8:[['Algoritm va uning turlari','Algoritm — maqsadga olib boruvchi aniq ketma-ket buyruqlar. Turlari: chiziqli (buyruqlar ketma-ket), tarmoqlanuvchi (shartga qarab tanlov) va takrorlanuvchi (sikl). Masalan, choy damlash — chiziqli algoritm.',[['Shartga qarab yo‘l tanlanadigan algoritm?',['Chiziqli','Tarmoqlanuvchi','Takrorlanuvchi','Tasodifiy'],1],['“Algoritm” so‘zi qaysi olim nomi bilan bog‘liq?',['Al-Xorazmiy','Nyuton','Ibn Sino','Edison'],0]]],
['Blok-sxemalar','Algoritmni grafik ko‘rinishda tasvirlash usuli. Oval — boshlanish va tugash, to‘g‘ri to‘rtburchak — amal, romb — shartni tekshirish, parallelogramm — ma’lumot kiritish yoki chiqarish.',[['Blok-sxemada shart qaysi shakl bilan belgilanadi?',['Oval','Romb','To‘rtburchak','Doira'],1],['Boshlanish va tugash belgisi?',['Oval','Romb','Uchburchak','Parallelogramm'],0]]],
['Taqdimotlar yaratish','Taqdimot dasturlari (PowerPoint, Google Slides) slaydlar yaratish uchun ishlatiladi. Yaxshi slaydda kam matn, aniq sarlavha va mos rasm bo‘ladi. Slaydlar orasiga o‘tish effektlarini qo‘shish mumkin.',[['Qaysi dastur taqdimot yaratish uchun?',['PowerPoint','Excel','Notepad','Paint'],0],['Yaxshi slayd qanday bo‘ladi?',['Juda ko‘p matnli','Kam matn, aniq sarlavha','Sarlavhasiz','Faqat mayda shrift'],1]]]],
9:[['Python: dasturlash asoslari','Python — o‘rganish oson dasturlash tili. print() ekranga chiqaradi: print("Salom!"). O‘zgaruvchi qiymat saqlaydi: yosh = 15. input() foydalanuvchidan ma’lumot oladi.',[['Python’da ekranga chiqarish funksiyasi?',['input()','print()','show()','write()'],1],['x = 5 dan keyin print(x + 2) nima chiqaradi?',['x + 2','52','7','5'],2]]],
['Shartli operator if','if sharti to‘g‘ri bo‘lsa, ichidagi buyruqlar bajariladi, aks holda else qismi ishlaydi: if ball >= 60: print("O‘tdi") else: print("Qayta topshiring"). Python’da ichki qism bo‘sh joy (otstup) bilan yoziladi.',[['if 10 > 5: print("Ha") nima chiqaradi?',['Ha','Yo‘q','Xato','Hech narsa'],0],['Shart bajarilmaganda qaysi qism ishlaydi?',['if','else','print','for'],1]]],
['Sun’iy intellekt nima?','Sun’iy intellekt (SI) — kompyuterlarning o‘rganish, tushunish va qaror qabul qilish qobiliyati. U ko‘plab ma’lumotlardan namunalarni o‘rganadi. SI ovozli yordamchilar, tarjimonlar va BilimAI kabi ta’lim platformalarida ishlatiladi. SI javoblarini doim tekshirib, mustaqil fikrlash muhim.',[['SI nimadan o‘rganadi?',['Ko‘plab ma’lumotlardan','Faqat elektrdan','Hech narsadan','Faqat rasmlardan'],0],['SI javobiga qanday munosabatda bo‘lish kerak?',['Ko‘r-ko‘rona ishonish','Tekshirib, mustaqil fikrlash','E’tibor bermaslik','Faqat nusxalash'],1]]]]
}
