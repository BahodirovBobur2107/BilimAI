[5,6,7,8,9].forEach(g=>{const b=document.createElement('button');b.textContent=g;b.dataset.g=g;b.setAttribute('aria-label',g+'-sinf');b.onclick=()=>{store.grade=g;save();syncGrades();render()};gw.appendChild(b)});
