P.forEach((a,i)=>{const rr=[1.6,2.2,3][i%3];c+=`<circle cx="${a[0]|0}" cy="${a[1]|0}" r="${rr*3}" fill="${col[i%3]}" fill-opacity=".12"/><circle cx="${a[0]|0}" cy="${a[1]|0}" r="${rr}" fill="${col[i%3]}"/>`});
return `<svg class="net" viewBox="0 0 1000 400" preserveAspectRatio="xMaxYMid slice" aria-hidden="true"><defs><radialGradient id="g1"><stop offset="0" stop-color="#7B5CFF" stop-opacity=".55"/><stop offset="1" stop-color="#7B5CFF" stop-opacity="0"/></radialGradient><radialGradient id="g2"><stop offset="0" stop-color="#E2367F" stop-opacity=".45"/><stop offset="1" stop-color="#E2367F" stop-opacity="0"/></radialGradient></defs><circle cx="820" cy="120" r="300" fill="url(#g1)"/><circle cx="940" cy="380" r="220" fill="url(#g2)"/>${l}${c}</svg>`}

function topicCard(s,g,i,showSub){const t=T[s][g][i],r=rec(s,g,i),c=sub(s).color;
const b=r?(r.s===r.t?`<span class="badge done">✓ ${r.s}/${r.t}</span>`:`<span class="badge part">${r.s}/${r.t}</span>`):'<span class="badge">Yangi</span>';
return `<button class="tcard" data-open="${s}|${g}|${i}"><span class="tnum" style="background:${c}">${showSub?ico(s,'#fff').replace('<svg','<svg width="24" height="24"'):i+1}</span><span><h3>${esc(t[0])}</h3><p>${showSub?esc(sub(s).name)+' · '+g+'-sinf — ':''}${esc(t[1])}</p></span>${b}</button>`}

function home(){const g=store.grade;
const all=SUBJ.flatMap(s=>T[s.id][g].map((t,i)=>[s.id,i]));
const day=Math.floor(Date.now()/864e5);const [ls,li]=all[day%all.length];const lt=T[ls][g][li];
const done=Object.keys(store.p).length;
let body;
if(S.q.trim()){const q=S.q.trim().toLowerCase();const res=[];SUBJ.forEach(s=>[5,6,7,8,9].forEach(gr=>T[s.id][gr].forEach((t,i)=>{if((t[0]+' '+t[1]).toLowerCase().includes(q))res.push(topicCard(s.id,gr,i,true))})));
body=`<div class="sec-h"><h2>Qidiruv natijalari</h2><p>${res.length} ta mavzu topildi</p></div><div class="topics">${res.join('')||'<p class="empty">Hech narsa topilmadi. Boshqa so‘z bilan qidirib ko‘ring yoki AI yordamchidan so‘rang.</p>'}</div>`}
else body=`<div class="sec-h"><h2>${g}-sinf fanlari</h2><p>Fanni tanlang va mavzularni o‘rganing</p></div><div class="subjects">${SUBJ.map(s=>{const p=subjProg(s.id,g);return `<button class="scard" data-subj="${s.id}"><span class="spine" style="background:${s.color}"></span><span style="display:flex;gap:14px;align-items:center"><span class="ico" style="background:color-mix(in srgb,${s.color} 15%,transparent);color:${s.color}">${ico(s.id)}</span><span><h3>${s.name}</h3><p>${esc(s.d)}</p></span></span><span class="bar"><i style="width:${p.done/p.n*100}%;background:${s.color}"></i></span><span class="meta"><span>${p.done}/${p.n} mavzu</span><span>${p.done?p.pct+'%':'Boshlanmagan'}</span></span></button>`}).join('')}</div>`;
return `<section class="hero">${net()}<div class="hero-in"><div><h1>Salom! Bugun nimani o‘rganamiz?</h1><p class="sub">BilimAI — 5–9-sinflar uchun sun’iy intellekt asosidagi ta’lim yordamchisi. Mavzuni o‘qing, AI’dan so‘rang va test bilan o‘zingizni sinang.</p>
<label class="search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5E5880" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input id="srch" type="search" placeholder="Mavzu qidiring: kasr, Amir Temur, Present Simple…" value="${esc(S.q)}" aria-label="Mavzu qidirish"></label>
<div class="chips"><span class="chip"><b>6</b> fan</span><span class="chip"><b>5–9</b> sinflar</span><span class="chip"><b>90</b> mavzu</span><span class="chip"><b>${done}</b> test topshirildi</span></div></div>
<div class="lotd"><small>Kun mavzusi · ${esc(sub(ls).name)}, ${g}-sinf</small><h3>${esc(lt[0])}</h3><p>${esc(lt[1])}</p><button class="btn" data-open="${ls}|${g}|${li}">O‘rganishni boshlash →</button></div></div></section>
<div class="wrap">${body}</div><p class="foot">Mavzular 5–9-sinf o‘quv dasturidagi asosiy bo‘limlar asosida qisqa tarzda tayyorlangan.</p>`}

function subject(){const s=sub(S.subj),g=store.grade,p=subjProg(s.id,g);
return `<section class="shead" style="background:${s.color}"><span class="ico" style="color:#fff">${ico(s.id)}</span><div style="flex:1"><button class="crumb" data-go="home">← Barcha fanlar</button><h1>${s.name}</h1><p>${g}-sinf · ${p.done}/${p.n} mavzu o‘rganildi${p.done?' · o‘rtacha natija '+p.pct+'%':''}</p></div></section>
<div class="wrap"><div class="topics">${T[s.id][g].map((_,i)=>topicCard(s.id,g,i)).join('')}</div>
<div class="panel" style="margin-top:18px"><h2>Boshqa mavzu kerakmi?</h2><p style="margin:0 0 14px;color:var(--mute)">AI yordamchi ${s.name.toLowerCase()} fanidan istalgan ${g}-sinf mavzusini tushuntirib beradi.</p><button class="btn ghost" data-ask="${esc(s.name)} fanidan ${g}-sinfda yana qanday muhim mavzular bor? Qisqa ro‘yxat ber.">AI’dan so‘rash</button></div></div>`}

let quiz=null;
function quizHTML(qs,id,showWhy){return qs.map((q,k)=>`<div class="q" data-q="${k}"><h4>${k+1}. ${esc(q[0])}</h4><div class="opts">${q[1].map((o,j)=>`<button class="opt" data-quiz="${id}" data-k="${k}" data-j="${j}">${esc(o)}</button>`).join('')}</div>${showWhy&&q[3]?`<p class="why" hidden>${esc(q[3])}</p>`:''}</div>`).join('')}
function topic(){const s=sub(S.subj),g=store.grade,i=S.ti,t=T[s.id][g][i],r=rec(s.id,g,i),n=T[s.id][g].length;
quiz={main:{qs:t[2],ans:{}},ai:null};
return `<section class="shead" style="background:${s.color}"><span class="ico" style="color:#fff">${ico(s.id)}</span><div style="flex:1"><button class="crumb" data-subj="${s.id}">← ${s.name}, ${g}-sinf</button><h1>${esc(t[0])}</h1><p>${i+1}-mavzu / ${n}${r?' · eng yaxshi natija: '+r.s+'/'+r.t:''}</p></div></section>
<div class="wrap"><div class="lesson">
<div class="panel"><h2>Qisqacha mazmun</h2><p class="expl">${esc(t[1])}</p>
<div class="tools"><button class="btn ghost aibtn" data-tool="simple">Soddaroq tushuntir</button><button class="btn ghost aibtn" data-tool="example">Yana misol keltir</button><button class="btn ghost aibtn" data-ask="__topic">AI’dan savol so‘rash</button><button class="btn line" id="speak" hidden>Tinglash</button></div>
<div class="aiout md" id="aiout"></div></div>
<div class="panel"><h2>Bilimingizni tekshiring</h2><div id="qMain">${quizHTML(t[2],'main')}</div><div id="sMain"></div></div>
<div class="panel" id="aiQuizP"><h2>AI bilan yangi test</h2><p style="margin:0 0 12px;color:var(--mute)">Sun’iy intellekt shu mavzu bo‘yicha har safar yangi 5 ta savol tuzib beradi.</p><button class="btn aibtn" id="genQ">5 ta savol yaratish</button><div id="qAI"></div><div id="sAI"></div></div>
<div class="pager">${i>0?`<button class="btn line" data-open="${s.id}|${g}|${i-1}">← Oldingi mavzu</button>`:'<span></span>'}${i<n-1?`<button class="btn line" data-open="${s.id}|${g}|${i+1}">Keyingi mavzu →</button>`:`<button class="btn line" data-subj="${s.id}">Barcha mavzular</button>`}</div>
</div></div>`}

function results(){const g=store.grade;const recs=Object.entries(store.p);const tot=recs.reduce((a,[,r])=>a+r.t,0),ok=recs.reduce((a,[,r])=>a+r.s,0);
const perfect=recs.filter(([,r])=>r.s===r.t).length;
const weak=[],fresh=[];SUBJ.forEach(s=>T[s.id][g].forEach((t,i)=>{const r=rec(s.id,g,i);if(r&&r.s<r.t)weak.push([s.id,i,r]);else if(!r)fresh.push([s.id,i])}));
return `<section class="shead" style="background:#1B1150"><div style="flex:1"><button class="crumb" data-go="home">← Bosh sahifa</button><h1>Natijalarim</h1><p>${g}-sinf bo‘yicha o‘sish va shaxsiy tavsiyalar</p></div></section>
<div class="wrap" style="display:grid;gap:18px;max-width:980px">
<div class="stats"><div class="stat"><b>${recs.length}</b><span>topshirilgan test (barcha sinflar)</span></div><div class="stat"><b>${tot?Math.round(ok/tot*100):0}%</b><span>to‘g‘ri javoblar ulushi</span></div><div class="stat"><b>${perfect}</b><span>mukammal o‘zlashtirilgan mavzu</span></div><div class="stat"><b>${weak.length}</b><span>takrorlash kerak (${g}-sinf)</span></div></div>
<div class="panel"><h2>${g}-sinf: fanlar bo‘yicha</h2>${SUBJ.map(s=>{const p=subjProg(s.id,g);return `<div class="prow"><span style="font-weight:700">${s.name}</span><span class="bar"><i style="width:${p.done/p.n*100}%;background:${s.color}"></i></span><span>${p.done}/${p.n}</span></div>`}).join('')}</div>
<div class="panel"><h2>Shaxsiy tavsiyalar</h2>
${weak.length?weak.map(([s,i,r])=>`<div class="rec"><span><b>${esc(T[s][g][i][0])}</b><br><small>${sub(s).name} · natija ${r.s}/${r.t} — takrorlash tavsiya etiladi</small></span><button class="btn ghost" data-open="${s}|${g}|${i}">Takrorlash</button></div>`).join(''):''}
${fresh.slice(0,3).map(([s,i])=>`<div class="rec"><span><b>${esc(T[s][g][i][0])}</b><br><small>${sub(s).name} · hali boshlanmagan</small></span><button class="btn ghost" data-open="${s}|${g}|${i}">Boshlash</button></div>`).join('')}
${!weak.length&&!fresh.length?'<p class="empty">Ajoyib! Bu sinfning barcha mavzulari mukammal o‘zlashtirildi.</p>':''}
<div class="tools"><button class="btn aibtn" id="plan">AI’dan haftalik o‘quv reja olish</button><button class="btn line" id="reset">Natijalarni tozalash</button></div><div class="aiout md" id="aiout"></div></div></div>`}

function render(){syncGrades();const v=S.view;$('#view').innerHTML=v==='home'?home():v==='subject'?subject():v==='topic'?topic():results();
document.querySelectorAll('.bnav button').forEach(b=>b.setAttribute('aria-current',b.dataset.nav==='res'?v==='results':b.dataset.nav==='home'?v!=='results':false));
if(v==='topic'&&tts){const b=$('#speak');if(b)b.hidden=false}
aiAvail();setCtx()}
function go(v,o={}){Object.assign(S,{view:v},o);render();window.scrollTo(0,0)}

/* quiz */
function answer(id,k,j,btn){const Q=id==='main'?quiz.main:quiz.ai;if(!Q||Q.ans[k]!==undefined)return;Q.ans[k]=j;const q=Q.qs[k],box=btn.closest('.q');
box.querySelectorAll('.opt').forEach((b,x)=>{b.disabled=true;if(x===q[2])b.classList.add('ok');else if(x===j)b.classList.add('no')});
const w=box.querySelector('.why');if(w)w.hidden=false;
if(Object.keys(Q.ans).length===Q.qs.length){const sc=Q.qs.filter((q,x)=>Q.ans[x]===q[2]).length,tt=Q.qs.length;
const msg=sc===tt?'Zo‘r! Hammasi to‘g‘ri.':sc>=tt/2?'Yaxshi natija! Xatolarni ko‘rib chiqing.':'Mavzuni yana bir bor o‘qib chiqing — keyingi safar albatta uddalaysiz.';
const el=id==='main'?$('#sMain'):$('#sAI');
el.innerHTML=`<div class="score"><b>${sc}/${tt}</b><span>${msg}</span><button class="btn ghost" data-retry="${id}">Qayta ishlash</button></div>`;
if(id==='main'){const key=pk(S.subj,store.grade,S.ti),old=store.p[key];if(!old||sc>=old.s)store.p[key]={s:sc,t:tt};save()}}}

/* AI */
let sample=null,dict=null,tts=null,aiChecked=false,busy=false;const hist=[];
const aiState=$('#aiState'),msgs=$('#msgs');
function ctxText(){const g=store.grade;if(S.view==='topic'){const s=sub(S.subj);return `${s.name} · ${g}-sinf · ${T[s.id][g][S.ti][0]}`}if(S.view==='subject')return `${sub(S.subj).name} · ${g}-sinf`;return `${g}-sinf · barcha fanlar`}
function setCtx(){$('#ctx').innerHTML=`<span>Mavzu: <b>${esc(ctxText())}</b></span>`;
const sg=S.view==='topic'?['Shu mavzuni tushuntir','Menga 3 ta mashq ber','Bu bilim hayotda qayerda kerak?']:S.view==='subject'?['Bu fanni qanday yaxshi o‘rganaman?','Eng muhim 3 mavzu qaysi?']:['Kasrlarni qanday qo‘shaman?','Present Simple nima?','Amir Temur haqida qisqacha'];
$('#sugg').innerHTML=sample?sg.map(x=>`<button type="button" data-s="${esc(x)}">${esc(x)}</button>`).join(''):''}
function SYS(){const g=store.grade;const s=S.subj?sub(S.subj):null;
return `Sen BilimAI — O‘zbekistondagi ${g}-sinf o‘quvchisi uchun mehribon va sabrli ta’lim yordamchisisan. Joriy kontekst: ${ctxText()}.${S.view==='topic'?' Darslikdagi izoh: '+T[S.subj][g][S.ti][1]:''}
Qoidalar: faqat o‘zbek tilida (lotin yozuvida) javob ber${s&&(s.id==='eng'||s.id==='rus')?'; misollarni '+(s.id==='eng'?'ingliz':'rus')+' tilida keltirib, o‘zbekcha izohla':''}. ${g}-sinf darajasiga mos, sodda so‘zlar bilan, qisqa yoz: 3–7 gap yoki qisqa ro‘yxat, kamida bitta misol. Uy vazifasini tayyor yechib berma — bosqichma-bosqich yo‘l ko‘rsat va o‘quvchining o‘zi o‘ylashiga yordam ber. Tarixiy sana va faktlarda aniq bo‘l; ishonching komil bo‘lmasa, shuni ayt. Ta’limga aloqasi yo‘q yoki yoshga mos bo‘lmagan savollarga muloyimlik bilan rad javobini berib, darsga qaytar. Formatlash: oddiy matn, qalin so‘z uchun **so‘z**, ro‘yxat uchun "- ".`}
function md(t){let h=esc(t).replace(/\*\*(.+?)\*\*/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code>$1</code>');
const L=h.split('\n');let out='',inl=false;L.forEach(l=>{const m=l.match(/^\s*[-•*]\s+(.*)/);if(m){if(!inl){out+='<ul>';inl=true}out+=`<li>${m[1]}</li>`}else{if(inl){out+='</ul>';inl=false}if(l.trim())out+=`<p>${l}</p>`}});if(inl)out+='</ul>';return out}
function aiErr(e){if(e&&e.code==='not_granted'){sample=null;aiAvail();return 'AI yordamchiga ruxsat berilmadi.'}if(e&&e.code==='rate_limited')return 'Hozir so‘rovlar ko‘p. Bir daqiqadan keyin qayta urinib ko‘ring.';return 'Kechirasiz, javob olishda xatolik yuz berdi. Qayta urinib ko‘ring.'}
function aiAvail(){const on=!!sample;
document.querySelectorAll('.aibtn,[data-ask]').forEach(b=>{b.disabled=!on;b.title=on?'':'AI yordamchi Claude ichida ochilganda ishlaydi'});
$('#q').disabled=!on;$('#send').disabled=!on;
aiState.textContent=on?'Tayyor · savol bering':aiChecked?'Hozir mavjud emas':'Ulanmoqda…';
const n=$('#aiNote');n.hidden=on||!aiChecked;n.textContent='AI yordamchi bu sahifa Claude ichida ochilganda ishlaydi. Mavzular va testlar esa doim ochiq.'}
function bubble(role,html){const d=document.createElement('div');d.className='m '+(role==='user'?'u':'a')+(role==='user'?'':' md');d.innerHTML=html;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;return d}
async function chat(text){text=text.trim();if(!text||busy||!sample)return;busy=true;$('#q').value='';
bubble('user',esc(text));const d=bubble('a','<span class="dots">O‘ylayapman</span>');
hist.push({role:'user',content:text});const h=hist.slice(-10);if(h[0].role!=='user')h.shift();
const msgsIn=h.map((m,x)=>x===0?{role:'user',content:SYS()+'\n\nO‘quvchi savoli: '+m.content}:m);
try{const r=await sample(msgsIn,{cache:false,onText:({text})=>{d.innerHTML=md(text);msgs.scrollTop=msgs.scrollHeight}});d.innerHTML=md(r.text);hist.push({role:'assistant',content:r.text})}
catch(e){d.innerHTML=esc(aiErr(e));hist.pop()}busy=false}
async function oneShot(prompt,box){if(!sample||busy)return;busy=true;box.classList.add('on');box.innerHTML='<span class="dots">AI tayyorlamoqda</span>';
try{const r=await sample(SYS()+'\n\n'+prompt,{onText:({text})=>{box.innerHTML=md(text)}});box.innerHTML=md(r.text)}catch(e){box.innerHTML=esc(aiErr(e))}busy=false}
async function genQuiz(){if(!sample||busy)return;const g=store.grade,t=T[S.subj][g][S.ti],btn=$('#genQ');busy=true;btn.disabled=true;$('#qAI').innerHTML='<p class="dots">Savollar tuzilmoqda</p>';$('#sAI').innerHTML='';
const p=`${sub(S.subj).name}, ${g}-sinf, mavzu: "${t[0]}". Izoh: ${t[1]}
Shu mavzu bo‘yicha ${g}-sinf darajasida 5 ta yangi test savoli tuz. Savollar o‘zbek tilida${S.subj==='eng'?' (gap misollari ingliz tilida)':S.subj==='rus'?' (misollar rus tilida)':''}, har birida 4 ta variant va faqat bitta to‘g‘ri javob. Faqat JSON qaytar: {"questions":[{"q":"savol","options":["A","B","C","D"],"answer":0,"explain":"nega to‘g‘ri — bir gap"}]} — answer to‘g‘ri variant indeksi (0–3).`;
try{let v;try{v=await sample.json(p)}catch(e){if(e&&e.code)throw e;const r=await sample(p);v=JSON.parse(r.text.slice(r.text.indexOf('{'),r.text.lastIndexOf('}')+1))}
const qs=(v.questions||[]).filter(q=>q&&q.q&&Array.isArray(q.options)&&q.options.length===4&&q.answer>=0&&q.answer<4).slice(0,5).map(q=>[q.q,q.options.map(String),q.answer|0,q.explain||'']);
if(!qs.length)throw{};quiz.ai={qs,ans:{}};$('#qAI').innerHTML=quizHTML(qs,'ai',true)}
catch(e){$('#qAI').innerHTML=`<p class="why">${esc(e&&e.code?aiErr(e):'Savollarni tuzib bo‘lmadi. Qayta urinib ko‘ring.')}</p>`}
btn.disabled=false;btn.textContent='Yana 5 ta savol';busy=false}
function openAI(){$('#ai').classList.add('show');setTimeout(()=>$('#q').focus(),50)}

if(window.claude&&claude.use){
claude.use('sample').then(x=>{sample=x;aiChecked=true;aiAvail();setCtx();if(x&&!msgs.children.length)bubble('a',md('Salom! Men **BilimAI** yordamchisiman. Istalgan mavzu bo‘yicha savol bering — sodda qilib tushuntirib beraman.'))}).catch(()=>{aiChecked=true;aiAvail()});
claude.use('dictation').then(d=>{dict=d;if(!d)return;const m=$('#mic');m.hidden=false;let base='';
d.onPartial(({text})=>{$('#q').value=base+text});d.onFinal(({text})=>{base+=text+' ';$('#q').value=base});
d.onState(({state})=>{m.classList.toggle('rec',state==='listening');m.setAttribute('aria-label',state==='listening'?'To‘xtatish':'Ovoz bilan so‘rash');if(state==='idle'){base=''}});
m.onclick=()=>{if(m.classList.contains('rec')){d.stop().catch(()=>{});return}base=$('#q').value?$('#q').value+' ':'';d.start().catch(e=>{if(e&&e.code==='not_granted')m.hidden=true})}}).catch(()=>{});
claude.use('tts').then(t=>{tts=t;if(!t)return;const b=$('#speak');if(b)b.hidden=false;t.onState(({state})=>{const b=$('#speak');if(b)b.textContent=state==='speaking'?'To‘xtatish':'Tinglash'})}).catch(()=>{});
}else{aiChecked=true}

/* events */
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;
if(t.dataset.subj){go('subject',{subj:t.dataset.subj});return}
if(t.dataset.open){const [s,g,i]=t.dataset.open.split('|');store.grade=+g;save();go('topic',{subj:s,ti:+i});return}
if(t.dataset.go){go(t.dataset.go);return}
if(t.dataset.quiz){answer(t.dataset.quiz,+t.dataset.k,+t.dataset.j,t);return}
if(t.dataset.retry){const id=t.dataset.retry;const Q=id==='main'?quiz.main:quiz.ai;Q.ans={};$(id==='main'?'#qMain':'#qAI').innerHTML=quizHTML(Q.qs,id,id==='ai');$(id==='main'?'#sMain':'#sAI').innerHTML='';return}
if(t.dataset.tool){const g=store.grade,tp=T[S.subj][g][S.ti];oneShot(t.dataset.tool==='simple'?`Mavzu: "${tp[0]}". Shu mavzuni ${g}-sinf o‘quvchisiga yanada soddaroq, hayotiy o‘xshatish bilan 4–6 gapda tushuntir.`:`Mavzu: "${tp[0]}". Shu mavzu bo‘yicha 2 ta yangi misol keltir va har birini qadamma-qadam qisqa tushuntir.`,$('#aiout'));return}
if(t.dataset.ask){const a=t.dataset.ask;openAI();if(a!=='__topic')chat(a);return}
if(t.dataset.s){chat(t.dataset.s);return}
if(t.dataset.nav){const n=t.dataset.nav;if(n==='ai')openAI();else{$('#ai').classList.remove('show');go(n==='res'?'results':'home')}return}
if(t.id==='genQ')genQuiz();
if(t.id==='speak'&&tts){if(t.textContent==='To‘xtatish'){tts.stop()}else tts.speak(T[S.subj][store.grade][S.ti][1]).catch(()=>{})}
if(t.id==='plan'){const g=store.grade;const sum=SUBJ.map(s=>{const p=subjProg(s.id,g);const w=T[s.id][g].map((x,i)=>{const r=rec(s.id,g,i);return r?`${x[0]} (${r.s}/${r.t})`:`${x[0]} (boshlanmagan)`}).join('; ');return `${s.name}: ${w}`}).join('\n');
oneShot(`O‘quvchining ${g}-sinf natijalari:\n${sum}\nShu natijalarga qarab 7 kunlik qisqa o‘quv reja tuz: har kuni 1–2 vazifa, avval zaif mavzular. Oxirida bitta rag‘batlantiruvchi gap yoz.`,$('#aiout'))}
if(t.id==='reset')$('#modal').classList.add('on');
});
$('#mYes').onclick=()=>{store.p={};save();$('#modal').classList.remove('on');render()};
$('#mNo').onclick=()=>$('#modal').classList.remove('on');
$('#home').onclick=()=>{S.q='';$('#ai').classList.remove('show');go('home')};
$('#resBtn').onclick=()=>go('results');
$('#aiClose').onclick=()=>$('#ai').classList.remove('show');
$('#aiForm').onsubmit=e=>{e.preventDefault();chat($('#q').value)};
$('#q').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();chat($('#q').value)}});
$('#q').addEventListener('input',e=>{e.target.style.height='auto';e.target.style.height=Math.min(140,e.target.scrollHeight)+'px'});
document.addEventListener('input',e=>{if(e.target.id==='srch'){S.q=e.target.value;const pos=e.target.selectionStart;render();const n=$('#srch');n.focus();n.setSelectionRange(pos,pos)}});
render();
}

</script>
</body>
</html>
