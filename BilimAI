const ico=(id,col)=>`<svg viewBox="0 0 24 24" fill="none" stroke="${col||'currentColor'}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[id]}</svg>`;
const sub=id=>SUBJ.find(s=>s.id===id);
const KEY='bilimai-v1';
let store={grade:7,p:{}};
try{const r=JSON.parse(localStorage.getItem(KEY)||'null');if(r&&r.p)store=r}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(store))}catch(e){}};
const S={view:'home',subj:null,ti:0,q:''};
const pk=(s,g,i)=>`${s}-${g}-${i}`;
const rec=(s,g,i)=>store.p[pk(s,g,i)];
function subjProg(s,g){const L=T[s][g];let done=0,sc=0,tt=0;L.forEach((_,i)=>{const r=rec(s,g,i);if(r){done++;sc+=r.s;tt+=r.t}});return{done,n:L.length,pct:tt?Math.round(sc/tt*100):0}}

/* grade switch */
