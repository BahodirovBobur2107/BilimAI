/* hero network */
function net(){let x=7;const r=()=>(x=(x*16807)%2147483647)/2147483647;const P=[];for(let i=0;i<46;i++)P.push([520+r()*480,r()*400]);let l='',c='';const col=['#FF5FA2','#5FE3F2','#A88BFF'];
